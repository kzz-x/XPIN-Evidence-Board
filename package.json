{
  "name": "xpin-evidence-board",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/regression.mjs",
    "test:media": "node scripts/audio-check.mjs",
    "test:v4": "node scripts/v4-regression.mjs",
    "format": "prettier --write src tests scripts vite.config.ts",
    "standalone": "node scripts/standalone.mjs",
    "compose": "tsx scripts/compose.ts",
    "test:motion": "node scripts/motion-regression.mjs",
    "project": "tsx scripts/project.ts",
    "native:example": "tsx examples/native-authoring.ts",
    "typecheck:native": "tsc --project tsconfig.native.json",
    "test:v5": "node scripts/v5-regression.mjs",
    "test:v51": "node scripts/v51-regression.mjs"
  },
  "dependencies": {
    "mediabunny": "1.61.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.0",
    "@types/three": "0.180.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
